{
  "installCommand": "npm ci --omit=dev --no-audit --no-fund",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/((?!__/).*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-qOhFsq0QMV2REqNwk5hGH5bZE9SkX6gt6yeyKdYPv+U=' 'sha256-w+H+wUeLccdbObT5GKLTn8iBhLBL4YfRFBScT1QRQKE=' https://apis.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://raw.githubusercontent.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firestore.googleapis.com https://www.googleapis.com https://apis.google.com; frame-src 'self' https://tcg-price-hunter.firebaseapp.com https://accounts.google.com https://apis.google.com; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/app.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(busca|pistas|conta|favoritos|alertas|configuracoes)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/assets/web/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/pagina?t=home"
    },
    {
      "source": "/oportunidades",
      "destination": "/api/pagina?t=oportunidades"
    },
    {
      "source": "/precos",
      "destination": "/api/pagina?t=precos"
    },
    {
      "source": "/pre-vendas",
      "destination": "/api/pagina?t=pre-vendas"
    },
    {
      "source": "/lojas",
      "destination": "/api/pagina?t=lojas"
    },
    {
      "source": "/comunidade",
      "destination": "/api/pagina?t=grupos"
    },
    {
      "source": "/como-funciona",
      "destination": "/api/pagina?t=como-funciona"
    },
    {
      "source": "/guia/glossario",
      "destination": "/api/pagina?t=glossario"
    },
    {
      "source": "/termos",
      "destination": "/api/pagina?t=termos"
    },
    {
      "source": "/privacidade",
      "destination": "/api/pagina?t=privacidade"
    },
    {
      "source": "/produto/:slug",
      "destination": "/api/pagina?t=produto&slug=:slug"
    },
    {
      "source": "/colecao/:slug",
      "destination": "/api/pagina?t=colecao&slug=:slug"
    },
    {
      "source": "/tipo/:slug",
      "destination": "/api/pagina?t=tipo&slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/ml/callback",
      "destination": "/api/ml-callback"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "/api/v1?path=:path*"
    },
    {
      "source": "/__/auth/:path*",
      "destination": "https://tcg-price-hunter.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://tcg-price-hunter.firebaseapp.com/__/firebase/:path*"
    },
    {
      "source": "/((?!data/|_vercel/|api/|__/).*)",
      "destination": "/app.html"
    }
  ],
  "cleanUrls": false,
  "trailingSlash": false,
  "functions": {
    "api/pagina.mjs": {
      "includeFiles": "{index.html,config/stores.json,config/affiliates.json}"
    },
    "api/v1.mjs": {
      "maxDuration": 15,
      "includeFiles": "{config/affiliates.json,config/afiliados/shopee.json,config/afiliados/amazon.json}"
    }
  },
  "regions": [
    "gru1"
  ],
  "redirects": [
    {
      "source": "/produtos",
      "destination": "/oportunidades",
      "permanent": true
    },
    {
      "source": "/pistas",
      "destination": "/oportunidades",
      "permanent": false
    },
    {
      "source": "/grupos",
      "destination": "https://chat.whatsapp.com/BshJHzdMsWx6MkmRDKt8Dv",
      "permanent": false
    },
    {
      "source": "/grupo",
      "destination": "https://chat.whatsapp.com/BshJHzdMsWx6MkmRDKt8Dv",
      "permanent": false
    },
    {
      "source": "/zap",
      "destination": "https://chat.whatsapp.com/BshJHzdMsWx6MkmRDKt8Dv",
      "permanent": false
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "data": false,
      "**": false
    }
  }
}
