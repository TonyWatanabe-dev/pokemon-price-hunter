{
  "installCommand": "npm ci --omit=dev --no-audit --no-fund",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/((?!__/).*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://apis.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://raw.githubusercontent.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firestore.googleapis.com https://www.googleapis.com https://apis.google.com; frame-src 'self' https://tcg-price-hunter.firebaseapp.com https://accounts.google.com https://apis.google.com; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/app.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/pagina?t=home"
    },
    {
      "source": "/oportunidades",
      "destination": "/api/pagina?t=oportunidades"
    },
    {
      "source": "/produtos",
      "destination": "/api/pagina?t=produtos"
    },
    {
      "source": "/precos",
      "destination": "/api/pagina?t=precos"
    },
    {
      "source": "/pre-vendas",
      "destination": "/api/pagina?t=pre-vendas"
    },
    {
      "source": "/como-funciona",
      "destination": "/api/pagina?t=como-funciona"
    },
    {
      "source": "/produto/:slug",
      "destination": "/api/pagina?t=produto&slug=:slug"
    },
    {
      "source": "/colecao/:slug",
      "destination": "/api/pagina?t=colecao&slug=:slug"
    },
    {
      "source": "/tipo/:slug",
      "destination": "/api/pagina?t=tipo&slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/ml/callback",
      "destination": "/api/ml-callback"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "/api/v1?path=:path*"
    },
    {
      "source": "/__/auth/:path*",
      "destination": "https://tcg-price-hunter.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://tcg-price-hunter.firebaseapp.com/__/firebase/:path*"
    },
    {
      "source": "/((?!data/|_vercel/|api/|__/).*)",
      "destination": "/app.html"
    }
  ],
  "cleanUrls": false,
  "functions": {
    "api/pagina.mjs": {
      "includeFiles": "index.html"
    },
    "api/v1.mjs": {
      "maxDuration": 15,
      "includeFiles": "config/affiliates.json"
    }
  },
  "regions": [
    "gru1"
  ]
}
